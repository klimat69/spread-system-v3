{
  "appId": "com.spreadsystem.v3",
  "name": "spread-system-v3",
  "productName": "Spread System v3",
  "directories": {
    "output": "../installer/dist"
  },
  "files": [
    "**/*"
  ],
  "extraResources": [
    {
      "from": "../backend",
      "to": "backend",
      "filter": [
        "**/*",
        "!**/__pycache__/**",
        "!**/.pytest_cache/**"
      ]
    },
    {
      "from": "../desktop/backend-runtime",
      "to": "backend-runtime",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../desktop/windows-python-embed",
      "to": "windows-python-embed",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../frontend/dist",
      "to": "frontend/dist"
    },
    {
      "from": "../data",
      "to": "data",
      "filter": [
        "config.example.json"
      ]
    },
    {
      "from": "../requirements.txt",
      "to": "requirements.txt"
    },
    {
      "from": "../installer/app-update.yml",
      "to": "app-update.yml"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "spread-system-v3-setup.${ext}",
    "executableName": "Spread System v3"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "allowElevation": true,
    "differentialPackage": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Spread System v3",
    "installerLanguages": [
      "en_US",
      "ru_RU"
    ]
  },
  "mac": {
    "target": [
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ],
    "artifactName": "spread-system-v3-${arch}.${ext}",
    "category": "public.app-category.finance",
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "artifactName": "spread-system-v3.${ext}",
    "category": "Finance"
  }
}
