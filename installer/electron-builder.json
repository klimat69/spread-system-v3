{
  "appId": "com.spreadsystem.v3",
  "productName": "Spread System v3",
  "directories": {
    "output": "../installer/dist"
  },
  "files": [
    "**/*"
  ],
  "extraResources": [
    {
      "from": "../backend",
      "to": "backend",
      "filter": [
        "**/*",
        "!**/__pycache__/**",
        "!**/.pytest_cache/**"
      ]
    },
    {
      "from": "../desktop/backend-runtime",
      "to": "backend-runtime",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../desktop/windows-python-embed",
      "to": "windows-python-embed",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../frontend/dist",
      "to": "frontend/dist"
    },
    {
      "from": "../data",
      "to": "data",
      "filter": [
        "config.example.json"
      ]
    },
    {
      "from": "../requirements.txt",
      "to": "requirements.txt"
    }
  ],
  "artifactName": "${productName}-${os}-${arch}.${ext}",
  "publish": [
    {
      "provider": "github",
      "owner": "${env.GH_OWNER}",
      "repo": "${env.GH_REPO}",
      "releaseType": "release"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "spread-system-v3-setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Spread System v3",
    "installerLanguages": [
      "en_US",
      "ru_RU"
    ]
  },
  "mac": {
    "target": [
      "dmg"
    ],
    "artifactName": "spread-system-v3.${ext}",
    "category": "public.app-category.finance"
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "artifactName": "spread-system-v3.${ext}",
    "category": "Finance"
  }
}
